# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # or the legacy anon key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). The site key also
# turns on the landing page's contact form; leave it blank to show a GitHub
# issues link instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email, sent through Resend (resend.com → API Keys)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend; defaults to the Resend test sender
CONTACT_FROM_EMAIL=BuzzFirst <hello@buzzfirst.app>

# Groups & Points (PLAN-groups-points.md)
# Self-hosted: leave false. Only changes the wording shown for gated features.
NEXT_PUBLIC_BILLING_ENABLED=false
# Must match the storage bucket's file_size_limit (see the groups_points migration)
NEXT_PUBLIC_MEDIA_MAX_MB=8
