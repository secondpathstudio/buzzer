# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # or the legacy anon key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Captcha on room creation (students joining never see one). Optional: leave
# all three blank, and don't set the Vault secret, to skip it. See the README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ROOM_TICKET_SECRET=

# Groups & Points (PLAN-groups-points.md)
# Self-hosted: leave false. Only changes the wording shown for gated features.
NEXT_PUBLIC_BILLING_ENABLED=false
# Must match the storage bucket's file_size_limit (see the groups_points migration)
NEXT_PUBLIC_MEDIA_MAX_MB=8
